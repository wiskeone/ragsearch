# v2.0: HTTPS-профиль nginx (опциональный).
#
# Использование:
#   1. Получите сертификаты (certbot/Let's Encrypt или свои):
#        nginx/ssl/fullchain.pem  — цепочка сертификата
#        nginx/ssl/privkey.pem    — приватный ключ
#   2. Подставьте свой домен вместо ragsearch.example.com
#   3. В docker-compose подключите профиль и тома:
#        nginx:
#          volumes:
#            - ./nginx/nginx.ssl.conf.template:/etc/nginx/conf.d/default.conf:ro
#            - ./nginx/ssl:/etc/nginx/ssl:ro
#          ports:
#            - "80:80"
#            - "443:443"
#   4. docker-compose up -d nginx
#
# HTTP-порт оставлен только для редиректа и Let's Encrypt HTTP-01.

server {
    listen 80;
    server_name ragsearch.example.com;

    # ACME challenge для Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ragsearch.example.com;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    # Современный TLS — конфигурация уровня A (Mozilla intermediate)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:ssl:10m;
    ssl_session_tickets off;

    # HSTS — включайте, только когда уверены в постоянном HTTPS
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 100M;

    location /static/ {
        alias /app/static/;
        expires 30d;
    }

    # media/ намеренно НЕ раздаётся через nginx: документы шифруются и
    # отдаются Django с проверкой прав (см. audit).
    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;   # важно для Django CSRF
        proxy_redirect off;
    }
}
