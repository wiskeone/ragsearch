{
  "title": "RAG Search Monitoring",
  "uid": "rag-monitor",
  "panels": [
    {
      "title": "Request Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(django_http_requests_total[1m])",
          "legendFormat": "requests/s"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}